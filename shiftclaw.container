[Unit]
Description=ShiftClaw (OpenClaw on Podman)
After=network-online.target

[Container]
# `latest` only moves once a build boots cleanly and passes the CVE scan
# (see .github/workflows/build.yaml) — safe to track directly. Requires
# `systemctl --user enable --now podman-auto-update.timer` to actually
# auto-update; otherwise this just affects what a manual restart pulls.
Image=ghcr.io/rarguello/shiftclaw:latest
Pull=always
AutoUpdate=registry
ContainerName=shiftclaw

EnvironmentFile=%h/.config/shiftclaw/env
Environment=XDG_CONFIG_HOME=/var/lib/openclaw
Environment=OPENCLAW_CONFIG_PATH=/var/lib/openclaw/openclaw.json
Environment=NODE_ENV=production
Environment=NPM_CONFIG_CACHE=/tmp/.npm
Environment=HOME=/var/lib/openclaw

Volume=%h/.local/share/shiftclaw:/var/lib/openclaw:Z
Tmpfs=/tmp

PublishPort=18789:18789
PublishPort=1455:1455
UserNS=keep-id:uid=1001,gid=1001

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
